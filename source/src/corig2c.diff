< 	case CHANNEL_ROAD:
< 		return m_pSightCheck->GetIsChecked();
< 	case CHANNEL_PRIVATE:
< 		return m_pPrivateCheck->GetIsChecked();
< 	case CHANNEL_TEAM:
< 		return m_pTeamCheck->GetIsChecked();
< 	case CHANNEL_GUILD:
< 		return m_pGuildCheck->GetIsChecked();
< 	case CHANNEL_WORLD:
< 		return m_pWorldCheck->GetIsChecked();
< 	case CHANNEL_SYSTEM:
