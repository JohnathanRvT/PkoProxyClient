< 		{
< 			++g_stUICoze._nSelectSayRow;
< 			if( g_stUICoze._nSelectSayRow>=MAX_PAGE_SAY )
< 				g_stUICoze._nSelectSayRow = 0;
< 		}
< 		break;
< 	case VK_UP:
< 		{
< 			--g_stUICoze._nSelectSayRow;
< 			if( g_stUICoze._nSelectSayRow < 0 )
< 				g_stUICoze._nSelectSayRow = MAX_PAGE_SAY - 1;
